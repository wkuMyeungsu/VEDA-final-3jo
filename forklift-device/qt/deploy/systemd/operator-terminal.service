[Unit]
Description=Forklift Safety Operator Terminal (operator_terminal)
# [Install] 섹션 의도적으로 없음 -> 부팅 시 자동기동 안 함 (DISPLAY 준비 전이라 실패함, 이유는 README 참고)

[Service]
Type=exec                                                                                   # exec 성공 확인 후 active 처리
WorkingDirectory=%h/VEDA_Final_project/forklift-device/qt/build                             # TODO: 클론 경로 확인
ExecStart=%h/VEDA_Final_project/forklift-device/qt/build/operator_terminal --camera CAM_01  # TODO: 경로/카메라 확인
Restart=on-failure                                                                          # 크래시 시만 재시작
RestartSec=3                                                                                # 재시작 대기 시간
StartLimitIntervalSec=60                                                                    # 재시작 횟수 제한 구간
StartLimitBurst=5                                                                           # 구간 내 5회 넘으면 failed
