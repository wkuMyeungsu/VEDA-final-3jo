# 보안
**/config.local*
*.pem
*.key
*.crt
*.csr
rtsp_credentials*
.env
forklift-device/qt/config/cameras.json
operator-device/qt/config/cameras.json

# 데모 영상
*.mp4
*.mkv

# 빌드 산출물
build/
*.o
*.so
*.ko

# 판정 이벤트 로그 DB (EventLogger가 실행 시 생성, WAL 모드라 -wal/-shm이 같이 생긴다)
server/judgment/events.db
server/judgment/events.db-wal
server/judgment/events.db-shm

# 판정 지연 계측 로그 (LatencyLogger가 실행 시 생성)
server/judgment/latency.csv

# 로컬 개발 환경
.venv/
.claude/settings.local.json

# IntelliSense용으로 로컬에 복사해둔 SDK 헤더 (도커 이미지에서 추출, 빌드엔 안 씀)
.sdk_stub/

# Qt/CMake (operator-device)
build-*/
out/
*.user
*.user.*
CMakeUserPresets.json
.vs/
.vscode/
*.obj
*.exe
*.pdb
*.ilk
*.dll
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
compile_commands.json

# forklift-device/sensors/kernel (Kbuild 커널 모듈 빌드 산출물, 경로 한정)
forklift-device/sensors/kernel/*.ko
forklift-device/sensors/kernel/*.mod
forklift-device/sensors/kernel/*.mod.c
forklift-device/sensors/kernel/Module.symvers
forklift-device/sensors/kernel/modules.order
forklift-device/sensors/kernel/.tmp_versions/
forklift-device/sensors/kernel/.*.cmdforklift-device/sensors/driver_test

# 커널 모듈 빌드 산출물 (make 시 자동 생성, *.o/*.ko 외 추가 규칙)
forklift-device/sensors/kernel/*.cmd
forklift-device/sensors/kernel/.*.cmd
forklift-device/sensors/kernel/Module.symvers
forklift-device/sensors/kernel/modules.order

# 판정 이벤트 로그 DB / 지연 로그 (실제 생성 경로 — server/judgment/가 아니라 루트 storage/)
storage/events.db
storage/events.db-wal
storage/events.db-shm
storage/latency.csv

# ArUco/검출 CSV 로그 (실행마다 타임스탬프로 자동 생성)
aruco_markers_*.csv
detections_*.csv
