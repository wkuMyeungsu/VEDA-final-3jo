[Unit]
Description=Server Admin GUI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=homography
WorkingDirectory=/opt/server-admin-gui
Environment=ADMIN_GUI_PORT=8000
Environment=HOMOGRAPHY_TOOL=/opt/homography/bin/homography_tool
ExecStart=/usr/bin/python3 /opt/server-admin-gui/server.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
