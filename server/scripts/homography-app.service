[Unit]
Description=Forklift Safety Homography App
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=veda3
WorkingDirectory=/home/veda3/forklift-safety-server/server/apps/homography_app/web
Environment=HOMOGRAPHY_APP_PORT=8001
Environment=HOMOGRAPHY_TOOL=/home/veda3/forklift-safety-server/server/apps/homography_app/processing/build/homography_tool
ExecStart=/usr/bin/python3 /home/veda3/forklift-safety-server/server/apps/homography_app/web/server.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
