#!/usr/bin/env bash
# forklift-bscpctl - 지게차 사각지대 충돌 방지 시스템 서비스 관리 CLI
#
# 사용법:
#   forklift-bscpctl status [앱|all]      상태 조회 (기본: 전체)
#   forklift-bscpctl start  [앱|all]      시작
#   forklift-bscpctl stop   [앱|all]      중지
#   forklift-bscpctl restart [앱|all]     재시작
#   forklift-bscpctl logs <앱> [줄수]     최근 저널 로그 (기본 30줄)
#
# 앱 이름: mqtt | safety | homography | monitoring | calibration | all
# (실제 systemd 유닛은 아래 APPS 표 참고)
set -euo pipefail

SYSTEMCTL_BIN="${FORKLIFT_SYSTEMCTL_BIN:-systemctl}"
JOURNALCTL_BIN="${FORKLIFT_JOURNALCTL_BIN:-journalctl}"

# root가 아니면 sudo로 재실행한다.
if [[ ${EUID} -ne 0 ]]; then
    exec sudo -- "$0" "$@"
fi

declare -A APPS=(
    ["mqtt"]="mosquitto"
    ["safety"]="forklift_safety_server"
    ["homography"]="homography-app"
    ["monitoring"]="monitoring-app"
    ["calibration"]="calibration-app"
)
ORDER=(mqtt safety homography monitoring calibration)

resolve() {  # 앱 별칭 -> 유닛명. all이면 전체 목록.
    local target="${1:-all}"
    if [[ "$target" == "all" || -z "$target" ]]; then
        local units=()
        for key in "${ORDER[@]}"; do units+=("${APPS[$key]}"); done
        printf '%s\n' "${units[@]}"
        return
    fi
    [[ -v APPS["$target"] ]] || { echo "forklift-bscpctl: 알 수 없는 앱 '$target' (mqtt|safety|homography|monitoring|calibration|all)" >&2; exit 2; }
    echo "${APPS[$target]}"
}

cmd="${1:-status}"; shift || true

case "$cmd" in
    status)
        units=$(resolve "${1:-all}") || exit 2
        printf '%-24s %-9s %s\n' "UNIT" "STATE" "ENABLED"
        for unit in $units; do
            printf '%-24s %-9s %s\n' "$unit" "$("${SYSTEMCTL_BIN}" is-active "$unit")" "$("${SYSTEMCTL_BIN}" is-enabled "$unit" 2>/dev/null || echo '-')"
        done
        ;;
    start|stop|restart)
        units=$(resolve "${1:-all}")
        "${SYSTEMCTL_BIN}" "$cmd" $units
        echo "OK: $cmd $(echo $units)"
        ;;
    enable|disable)
        units=$(resolve "${1:-all}")
        "${SYSTEMCTL_BIN}" "$cmd" $units
        echo "OK: $cmd $(echo $units)"
        ;;
    logs)
        [[ $# -ge 1 ]] || { echo "forklift-bscpctl logs <앱> [줄수]" >&2; exit 2; }
        unit=$(resolve "$1"); lines="${2:-30}"
        "${JOURNALCTL_BIN}" -u "$unit" -n "$lines" --no-pager
        ;;
    *)
        grep '^#' "$0" | sed -n '/사용법:/,/^#$/p' | sed 's/^# \{0,2\}//'
        exit 2
        ;;
esac
