{
  "network": {
    "mqtt_host": "127.0.0.1", "mqtt_port": 8883,
    "result_heartbeat_ms": 200, "tls_enabled": true,
    "ca_cert_path": "certs/ca.crt",
    "client_cert_path": "certs/client-server.crt",
    "client_key_path": "certs/client-server.key"
  },
  "handover": {"confirm_frames": 3, "lost_grace_ms": 6000},
  "tracking": {"iou_threshold": 0.3, "world_distance_threshold_mm": 1000.0, "track_freshness_ms": 1000, "track_timeout_ms": 3000},
  "sensor": {"stub_tof_distance_mm": 5000.0, "stale_timeout_ms": 1200},
  "stream": {"rtsp_latency_ms": 100, "appsink_max_buffers": 5, "metadata_queue_capacity": 256, "eos_force_timeout_s": 10, "connect_timeout_s": 15, "max_retries": 10, "retry_delay_s": 3},
  "output_storage": {
    "enable_object_csv_logging": false,
    "enable_aruco_csv_logging": false,
    "enable_latency_csv_logging": false,
    "server_log": "runtime/server.log",
    "runtime_status": "runtime/runtime-status.json",
    "object_csv": "storage/detections.csv",
    "aruco_csv": "storage/aruco_markers.csv",
    "event_db": "storage/events.db",
    "latency_csv": "storage/latency.csv"
  }
}
